PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
API_ORIGIN=http://localhost:5000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Add this exact URL to Google Cloud Console > OAuth client > Authorized redirect URIs:
# http://localhost:5000/api/auth/google/callback
# Generate a private value with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_JWT_SECRET=
NODE_ENV=development
AUTH_EXPOSE_REGISTRATION_OTP=false
AUTH_LOGIN_RATE_LIMIT=10
AUTH_RESET_RATE_LIMIT=5
AUTH_RATE_LIMIT_WINDOW_MS=900000

# PostgreSQL connection string used by authentication.
DATABASE_URL=
# Optional alias if your deployment uses DB_URL instead.
DB_URL=

SUPABASE_URL=
# Public/anon key used for password sign-in; use SUPABASE_PUBLISHABLE_KEY for new projects.
SUPABASE_PUBLISHABLE_KEY=
# Legacy variable name accepted as a fallback.
SUPABASE_ANON_KEY=
# Server-side admin key; never expose this to the frontend.
SUPABASE_SERVICE_ROLE_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

RESEND_API_KEY=
EMAIL_FROM=

SEPAY_API_KEY=
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
SEPAY_ENV=sandbox
SEPAY_CHECKOUT_MODE=hosted
# Generate a separate HMAC-SHA256 secret for SePay Webhooks; do not reuse Merchant/IPN credentials.
SEPAY_BANK_WEBHOOK_SECRET=
SEPAY_BANK_CODE=
SEPAY_BANK_NAME=
SEPAY_ACCOUNT_NUMBER=
# SePay's QR image supports an unaccented holder name.
SEPAY_ACCOUNT_NAME=
# Separate SePay Dashboard → Payment Gateway → Configuration → IPN secret key
SEPAY_IPN_SECRET_KEY=

PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
